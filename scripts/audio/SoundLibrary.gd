class_name SoundLibrary
extends Resource
## Named sound effects with variants, generated by tools/audio/synth_audio.py.

## Sound name -> Array of AudioStream variants.
@export var sounds: Dictionary = {}
## Names that are meant to loop while an action is held.
@export var loops: PackedStringArray = []


func has_sound(sound_name: String) -> bool:
	return sounds.has(sound_name) and not sounds[sound_name].is_empty()


func get_variants(sound_name: String) -> Array:
	return sounds.get(sound_name, [])
