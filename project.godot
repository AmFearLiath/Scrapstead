; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Scrapstead"
config/description="Every Scrap Has a Story."
config/version="0.1.0-p1"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.168627, 0.129412, 0.105882, 1)
config/icon="res://assets/branding/icon.svg"

[autoload]

SaveService="*res://scripts/core/SaveService.gd"
GameSession="*res://scripts/core/GameSession.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/scrapstead_theme.tres"

