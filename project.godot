[internationalization]

locale/translations=PackedStringArray("res://localization/scrapstead.en.translation", "res://localization/scrapstead.de.translation")
locale/fallback="en"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true
jolt_physics_3d/simulation/areas_detect_static_bodies=true

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
